{
  "seed": 13,
  "llm": {
    "backend": "hf",
    "model_name": "Qwen/Qwen2.5-3B-Instruct",
    "max_new_tokens": 128,
    "temperature": 0.7,
    "device": "cuda"
  },
  "retriever": {
    "backend": "dense",
    "model_name": "sentence-transformers/all-MiniLM-L6-v2",
    "top_k": 5
  },
  "scoring": {
    "backend": "nli",
    "nli_model": "MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli",
    "device": "cuda",
    "faithful_threshold": 0.5
  },
  "uq": {
    "n_samples": 3,
    "paraphrase_prompts": 3
  },
  "router": {
    "kind": "learned",
    "calibration": "isotonic",
    "use_graph_features": true,
    "fixed_faithful_threshold": 0.5,
    "flag_threshold": 0.35
  },
  "correction": {
    "enabled": true,
    "budget": 3,
    "flag_threshold": 0.5,
    "safety_checked": true
  }
}